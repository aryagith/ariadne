# Demo never calls OpenAI or Laya, even if credentials are present.
PROVIDER_MODE=demo
OPENAI_MODEL=gpt-6-astra
OPENAI_API_KEY=
LAYA_URL=http://127.0.0.1:8001
LAYA_API_KEY=
# Server setup: README "Run with Laya". In its separate environment run
# python scripts/serve_laya.py (localhost:8001, typed-decisions, CPU by default).
# Check from the app environment: python -m backend.model_routing
# The launcher reads shell variables, not this file; export LAYA_API_KEY there too
# if you set one here. It also accepts LAYA_PORT, LAYA_DEVICE and LAYA_THREADS.
# Additional explicit UI consent is required per verified profile in provider mode.
ALLOW_PROVIDER_PROCESSING=false
# Optional stable dashboard passphrase. Otherwise generated in data/auth-token.txt.
APP_PASSWORD=
APP_ORIGIN=http://127.0.0.1:8000
# Optional private ntfy topic URL; no notifications are sent without UI consent.
NTFY_URL=
NTFY_TOKEN=
PUBLIC_APP_URL=
POLL_SECONDS=600

# LaTeX skill: task routing and CLI transport (separate from legacy PROVIDER_MODE).
# Laya receives bounded task metadata only. If unavailable/uncertain, routing uses
# the configured reasoning tier and records the degraded decision. Review never
# falls back. Set rules for an explicitly offline deterministic routing policy.
AUTOAPPLY_ROUTER=laya
AUTOAPPLY_MODEL_BACKEND=codex
# Optional overrides. Reviewer must differ from both writer models.
# Codex defaults: gpt-6-luna low / gpt-6-astra high / gpt-6-sol medium.
# Go defaults: opencode-go/glm-5.3-flash / opencode-go/glm-5.3 / opencode-go/kimi-k2.6.
# Go uses provider-default reasoning; Codex effort settings are not sent to Go.
# Skills matching is pinned separately: gpt-6-luna low on Codex;
# opencode/space-bunny-free on OpenCode (Zen login, separate from Go).
# Skills never escalates to a paid model; unavailable free service stops the stage.
# AUTOAPPLY_CHEAP_MODEL=gpt-6-luna
# AUTOAPPLY_REASONING_MODEL=gpt-6-astra
# AUTOAPPLY_REVIEWER_MODEL=gpt-6-sol
# AUTOAPPLY_CHEAP_EFFORT=low
# AUTOAPPLY_REASONING_EFFORT=high
# AUTOAPPLY_REVIEWER_EFFORT=medium
